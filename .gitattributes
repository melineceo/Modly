# Текст в репозитории — с LF; Git на Windows сам отдаёт его как удобно.
* text=auto eol=lf

# Windows-скрипты — с CRLF, иначе cmd и PowerShell 5.1 спотыкаются.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.webp binary
*.zip binary
*.exe binary
*.dll binary
