// Панель управления модом: Modly рисует то, что мод описал по протоколу.

import { Theme, Lang } from "theme.slint";
import { Icons } from "icons.slint";
import { Store, LiveControl, LiveSection } from "store.slint";
import { Icon, IconTile, Btn, ConfirmBtn, Toggle, HotkeyChip, SliderBar, NumberField, TextField, Segmented, ChipGrid, PresetRow, Card, Badge, EmptyState } from "widgets.slint";

// Подпись элемента: иконка + название + пояснение.
component ControlLabel inherits HorizontalLayout {
    in property <LiveControl> c;
    spacing: 12px;
    horizontal-stretch: 1;
    if root.c.has-icon: VerticalLayout {
        alignment: center;
        IconTile {
            icon: root.c.icon;
            size: 34px;
            tint: root.c.tone == "danger" ? Theme.danger : root.c.tone == "success" ? Theme.success : root.c.tone == "warning" ? Theme.warning : Theme.accent;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.c.label;
            color: root.c.enabled ? Theme.text : Theme.text-3;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
        }
        if root.c.description != "": Text {
            text: root.c.description;
            color: Theme.text-3;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// Горячая клавиша в строке переключателя или кнопки.
component RowHotkey inherits VerticalLayout {
    in property <LiveControl> c;
    alignment: center;
    HotkeyChip {
        key: root.c.hotkey;
        label: root.c.label;
        busy: root.c.hotkey-busy;
        capturing: Store.hotkey-capture == root.c.id;
        start => {
            Store.hotkey-capture-start(root.c.id);
        }
        cancel => {
            Store.hotkey-capture-cancel(root.c.id);
        }
        clear => {
            Store.hotkey-clear(root.c.id);
        }
        pressed(text, ctrl, alt, shift, win) => {
            Store.hotkey-pressed(root.c.id, text, ctrl, alt, shift, win);
        }
    }
}

export component ControlRow inherits VerticalLayout {
    in property <LiveControl> c;

    // число с округлением по шагу — для подписи ползунка во время перетаскивания
    pure function fmt(v: float, step: float) -> string {
        return step >= 1 || (step <= 0 && round(v) == v) ? "\{round(v)}" : step >= 0.1 ? "\{round(v * 10) / 10}" : "\{round(v * 100) / 100}";
    }

    // toggle
    if root.c.kind == "toggle": HorizontalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        ControlLabel {
            c: root.c;
        }
        if Store.hotkey-capture == root.c.id: Text {
            text: Lang.t("Esc — отмена, Backspace — снять", "Esc — cancel, Backspace — clear");
            color: Theme.text-3;
            font-size: 11.5px;
            vertical-alignment: center;
        }
        RowHotkey {
            c: root.c;
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                label: root.c.label;
                checked: root.c.checked;
                enabled: root.c.enabled;
                toggled(v) => {
                    Store.live-set-bool(root.c.id, v);
                }
            }
        }
    }

    // button
    if root.c.kind == "button": HorizontalLayout {
        padding: 12px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        ControlLabel {
            c: root.c;
        }
        if Store.hotkey-capture == root.c.id: Text {
            text: Lang.t("Esc — отмена, Backspace — снять", "Esc — cancel, Backspace — clear");
            color: Theme.text-3;
            font-size: 11.5px;
            vertical-alignment: center;
        }
        RowHotkey {
            c: root.c;
        }
        VerticalLayout {
            alignment: center;
            ConfirmBtn {
                text: root.c.text != "" ? root.c.text : Lang.t("Выполнить", "Run");
                confirm-text: root.c.confirm;
                kind: root.c.tone == "accent" ? "primary" : root.c.tone == "danger" ? "danger" : root.c.tone == "success" ? "success" : "secondary";
                enabled: root.c.enabled;
                compact: true;
                show-icon: root.c.tone == "accent";
                icon: Icons.bolt;
                clicked => {
                    Store.live-invoke(root.c.id);
                }
            }
        }
    }

    // slider
    if root.c.kind == "slider": VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 16px;
            ControlLabel {
                c: root.c;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 30px;
                    min-width: 64px;
                    border-radius: 8px;
                    background: Theme.input;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.fmt(slider.shown, root.c.step) + (root.c.unit != "" ? " " + root.c.unit : "");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        slider := SliderBar {
            value: root.c.value;
            minimum: root.c.min;
            maximum: root.c.max;
            step: root.c.step;
            enabled: root.c.enabled;
            dragged(v) => {
                Store.live-drag-number(root.c.id, v);
            }
            committed(v) => {
                Store.live-set-number(root.c.id, v);
            }
        }
        HorizontalLayout {
            Text {
                text: root.fmt(root.c.min, root.c.step);
                color: Theme.text-3;
                font-size: 11px;
            }
            Text {
                horizontal-stretch: 1;
                text: root.fmt(root.c.max, root.c.step);
                color: Theme.text-3;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }

    // number
    if root.c.kind == "number": VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 16px;
            ControlLabel {
                c: root.c;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    NumberField {
                        value: root.c.value;
                        text: root.c.text;
                        minimum: root.c.min;
                        maximum: root.c.max;
                        step: root.c.step;
                        enabled: root.c.enabled;
                        committed(v) => {
                            Store.live-set-number(root.c.id, v);
                        }
                    }
                    if root.c.unit != "": Text {
                        text: root.c.unit;
                        color: Theme.text-3;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.c.presets.length > 0: PresetRow {
            presets: root.c.presets;
            enabled: root.c.enabled;
            picked(v) => {
                Store.live-set-number(root.c.id, v);
            }
        }
    }

    // text
    if root.c.kind == "text": HorizontalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        ControlLabel {
            c: root.c;
        }
        VerticalLayout {
            alignment: center;
            TextField {
                width: 240px;
                text: root.c.text;
                placeholder: root.c.placeholder;
                enabled: root.c.enabled;
                accepted(t) => {
                    Store.live-set-text(root.c.id, t);
                }
            }
        }
    }

    // select: немного вариантов
    if root.c.kind == "segmented": VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        ControlLabel {
            c: root.c;
        }
        Segmented {
            options: root.c.options;
            enabled: root.c.enabled;
            picked(v) => {
                Store.live-pick(root.c.id, v);
            }
        }
    }

    // select: много вариантов или несколько сразу
    if root.c.kind == "chips": VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        ControlLabel {
            c: root.c;
        }
        ChipGrid {
            options: root.c.options;
            enabled: root.c.enabled;
            picked(v) => {
                Store.live-pick(root.c.id, v);
            }
        }
    }

    // показатель
    if root.c.kind == "stat": HorizontalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        ControlLabel {
            c: root.c;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Text {
                text: root.c.text;
                color: root.c.tone == "default" ? Theme.text : Theme.tone(root.c.tone);
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.c.unit != "": Text {
                text: root.c.unit;
                color: Theme.text-3;
                font-size: 12.5px;
                vertical-alignment: center;
            }
        }
    }

    // прогресс
    if root.c.kind == "progress": VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        HorizontalLayout {
            ControlLabel {
                c: root.c;
            }
            Text {
                text: root.c.text;
                color: Theme.text-2;
                font-size: 12.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.surface-3;
            Rectangle {
                x: 0;
                width: parent.width * max(0, min(1, root.c.value));
                border-radius: 4px;
                background: @linear-gradient(90deg, #8b5cf6 0%, #22d3ee 100%);
                animate width { duration: 250ms; easing: ease-out; }
            }
        }
    }

    // пояснение
    if root.c.kind == "note": HorizontalLayout {
        padding: 12px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                source: root.c.tone == "warning" || root.c.tone == "danger" ? Icons.alert : Icons.info;
                size: 16px;
                tint: root.c.tone == "default" ? Theme.text-3 : Theme.tone(root.c.tone);
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.c.label;
            color: root.c.tone == "default" ? Theme.text-2 : Theme.tone(root.c.tone);
            font-size: 12.5px;
            wrap: word-wrap;
        }
    }

    // разделитель
    if root.c.kind == "separator": VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 6px;
        padding-bottom: 6px;
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}

component SectionCard inherits Card {
    in property <LiveSection> s;
    VerticalLayout {
        padding-top: root.s.title != "" ? 16px : 6px;
        padding-bottom: 6px;
        if root.s.title != "": VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-bottom: 6px;
            spacing: 3px;
            Text {
                text: root.s.title;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
            }
            if root.s.description != "": Text {
                text: root.s.description;
                color: Theme.text-3;
                font-size: 12.5px;
                wrap: word-wrap;
            }
        }
        for c[i] in root.s.controls: VerticalLayout {
            if i > 0 && c.kind != "separator": Rectangle {
                height: 1px;
                background: Theme.border;
                opacity: 0.6;
            }
            ControlRow {
                c: c;
            }
        }
    }
}

// Вкладки страниц мода.
component PageTabs inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;
    for p[i] in Store.live-pages: Rectangle {
        accessible-role: tab;
        accessible-label: p.title;
        accessible-checkable: true;
        accessible-checked: Store.live-page == i;
        accessible-action-default => {
            Store.live-select-page(i);
        }
        height: 36px;
        horizontal-stretch: 0;
        border-radius: 10px;
        background: Store.live-page == i ? Theme.surface-3 : tab-ta.has-hover ? #ffffff08 : transparent;
        border-width: 1px;
        border-color: Store.live-page == i ? Theme.border-strong : transparent;
        animate background { duration: 120ms; }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 16px;
            spacing: 8px;
            if p.has-icon: VerticalLayout {
                alignment: center;
                Icon {
                    source: p.icon;
                    size: 16px;
                    tint: Store.live-page == i ? Theme.accent-2 : Theme.text-3;
                }
            }
            Text {
                text: p.title;
                color: Store.live-page == i ? Theme.text : Theme.text-2;
                font-size: 13.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        tab-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Store.live-select-page(i);
            }
        }
    }
}

export component LivePanel inherits VerticalLayout {
    spacing: 14px;

    // заголовок панели
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Store.live-connected ? Theme.success : Theme.text-3;
                drop-shadow-blur: Store.live-connected ? 10px : 0;
                drop-shadow-color: #34d399;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: Store.live-connected ? Store.live-title : Lang.t("Панель управления", "Control panel");
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
            }
            Text {
                text: Store.live-connected ? Store.live-subtitle : Lang.t("Появится, когда мод подключится к Modly", "Appears when a mod connects to Modly");
                color: Theme.text-3;
                font-size: 12.5px;
            }
        }
        if Store.live-tabs.length > 1: HorizontalLayout {
            spacing: 6px;
            for t[i] in Store.live-tabs: Btn {
                text: t.title;
                compact: true;
                kind: Store.live-tab == i ? "secondary" : "ghost";
                clicked => {
                    Store.live-select-tab(i);
                }
            }
        }
    }

    if Store.live-connected && Store.live-paused: Rectangle {
        border-radius: 12px;
        background: Theme.info.transparentize(0.88);
        border-width: 1px;
        border-color: Theme.info.transparentize(0.7);
        HorizontalLayout {
            padding: 12px;
            padding-left: 14px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.pause;
                    size: 16px;
                    tint: Theme.info;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: Lang.t("Игра на паузе — её окно не активно. Нажатия применятся, как только вы вернётесь в игру.", "The game is paused — its window isn't active. Your changes apply as soon as you switch back to the game.");
                color: Theme.info.brighter(0.2);
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }

    if Store.live-connected && Store.live-status != "": Rectangle {
        border-radius: 12px;
        background: Theme.tone(Store.live-status-tone).transparentize(0.88);
        border-width: 1px;
        border-color: Theme.tone(Store.live-status-tone).transparentize(0.7);
        HorizontalLayout {
            padding: 12px;
            padding-left: 14px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: Store.live-status-tone == "warning" || Store.live-status-tone == "danger" ? Icons.alert : Icons.info;
                    size: 16px;
                    tint: Theme.tone(Store.live-status-tone);
                }
            }
            Text {
                horizontal-stretch: 1;
                text: Store.live-status;
                color: Theme.tone(Store.live-status-tone).brighter(0.2);
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }

    // вкладки прокручиваются по горизонтали — сколько бы страниц ни было у мода, вёрстка не ломается
    if Store.live-connected && Store.live-pages.length > 1: Flickable {
        height: 38px;
        content-height: 38px;
        content-width: max(self.width, tabs.preferred-width);
        tabs := PageTabs {
            height: 38px;
        }
    }

    if Store.live-connected: VerticalLayout {
        spacing: 14px;
        for s in Store.live-sections: SectionCard {
            s: s;
        }
    }

    if !Store.live-connected: Card {
        min-height: 300px;
        EmptyState {
            icon: Icons.bolt;
            title: Store.game.running ? Lang.t("Игра запущена, мод не подключился", "The game is running, no mod connected") : Lang.t("Мод не подключён", "No mod connected");
            text: Store.game.running
                ? Lang.t("Если мод установлен, он подключится в течение пары секунд после загрузки. Моды без поддержки Modly работают как обычно — просто без этой панели.", "If a mod is installed it connects a couple of seconds after loading. Mods without Modly support work as usual — just without this panel.")
                : Lang.t("Установите мод и запустите игру — его переключатели, ползунки и кнопки появятся здесь. Мод работает и без Modly: своё меню в игре никуда не денется.", "Install a mod and start the game — its toggles, sliders and buttons will appear here. The mod works without Modly too: its in-game menu stays.");
        }
    }
}
