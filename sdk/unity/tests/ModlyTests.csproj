<Project Sdk="Microsoft.NET.Sdk">

  <!-- Автотест C#-SDK Modly: dotnet run (или run.ps1). Modly.cs вшивается как исходник, как в настоящем моде. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- как в модах Unity: Modly.cs (а заодно и тест) должны собираться C# 7.3 -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ModlyTests</RootNamespace>
    <AssemblyName>ModlyTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Modly.cs" Link="Modly.cs" />
  </ItemGroup>

</Project>
